# ============================================================
# FixFlow AI - Environment Variable Configuration Template
# COPY THIS FILE TO .env IN YOUR LOCAL ENVIRONMENT BEFORE RUNNING
# ============================================================

# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fixflow_db
POSTGRES_USER=fixflow_admin
POSTGRES_PASSWORD=fixflow_secure_password_2026

# Connection String for ASP.NET Core EF Core
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=fixflow_db;Username=fixflow_admin;Password=fixflow_secure_password_2026;

# JWT Security Settings
Jwt__SecretKey=FixFlow_Super_Secret_JWT_Signing_Key_SLIIT_2026_SE3090_Minimum_256_Bits!
Jwt__Issuer=FixFlow.Api
Jwt__Audience=FixFlow.Clients
Jwt__ExpiryInMinutes=480

# Internal Agentic AI Microservice URL (Called strictly by ASP.NET Core)
AgenticAI__BaseUrl=http://localhost:8000
AgenticAI__TimeoutSeconds=30

# External Distance Matrix Service (OSRM Ecosystem with Haversine fallback)
DistanceMatrix__BaseUrl=http://router.project-osrm.org
DistanceMatrix__TimeoutSeconds=5
DistanceMatrix__UseFallback=true

# File Upload Configuration
FileStorage__UploadDirectory=./uploads
FileStorage__MaxSizeBytes=10485760

# Frontend Web Application Settings
VITE_API_BASE_URL=http://localhost:5000/api

# Mobile Application Settings
FLUTTER_API_BASE_URL=http://10.0.2.2:5000/api
